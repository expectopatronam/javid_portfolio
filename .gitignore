# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing & Coverage
/coverage

# Next.js build outputs and caches
/.next/
/out/
.next

# Production builds
/build
/dist

# Environment variables & secrets
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
*.pem

# Debug & runtime logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# Vercel deployment metadata
.vercel

# TypeScript & build info
*.tsbuildinfo
next-env.d.ts

# Operating system files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDEs and Editors
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak
*~

# Compressed archives & temporary asset bundles
*.zip
*.tar.gz
*.tgz
*.rar
*.7z

# Staging/scratch asset bundles (production assets live cleanly in /public/shots and /public/icons)
public/portfolio-redesign/
public/*.zip
